/* by Namanyay Goel
   ========================================================================== */

h1, h2, h3, h4, h5, h6 {
  font-weight: 400;
}

#app
  overflow-x hidden

.page
  background #fff
  overflow hidden

a
  color #222
  transition color .2s ease, border-color .2s ease

/* Forms
============================================ */

.control
  display block
  margin 0 0 2em
  position relative

  .label
    display block
    margin 0 0 .75rem
    position absolute
    top .675rem
    left 1rem
    transform-origin center left
    transition all .3s cubic-bezier(0.645, 0.045, 0.355, 1)

  .element
    margin-top 2.5em
    transition all .3s cubic-bezier(0.645, 0.045, 0.355, 1)
    background #222

    &:focus, &:valid
      outline none

      + .label
        transform translate(0, -2.5rem) scale(0.875)

      ~ .foci
        width 100%
        left 0

  .foci
    position absolute
    height 2px
    transition all .4s cubic-bezier(0.785, 0.135, 0.15, 0.86)
    width 0
    left 50%
    background #444444

input, textarea, select
  padding 1em
  background none
  display block
  border none
  width 100%
  resize none

select
  appearance none

textarea
  height 7.5em

.button, button
  font-family $font--sans
  text-transform uppercase
  font-weight 700
  letter-spacing 2px
  background #222222
  color white
  display inline-block
  padding .75em 1.5em
  border none
  outline none
  transition background-color .25s ease, color .25s ease, border-color .25s ease, transform .25s ease

  &:hover
    transform translateY(-1px)

.back-link
  display inline-block
  font-family $font--sans
  font-size .8125em
  letter-spacing 1.5px
  text-transform uppercase
  text-decoration none
  margin 1.5em 0 0
  color inherit
  opacity .8
  transition opacity .2s ease, color .2s ease

  > span
    border-bottom 1px solid $color--highlight
    padding-bottom 2px

  &:hover
    opacity 1
    color $color--highlight

.press-intro .back-link, .kit-intro .back-link, .media-intro .back-link
  color $color--hero-text

@media (prefers-reduced-motion: reduce)
  *, *::before, *::after
    animation-duration .01ms !important
    animation-iteration-count 1 !important
    transition-duration .01ms !important
    scroll-behavior auto !important