module.exports = [{"slug":"clas","title":"Clas","year":2012,"dateLabel":"November 2012","category":"experiments","summary":"A single-page website I made at fourteen.","paragraphs":["I made Clas when I was fourteen. Clicking a section fades one panel into the next, all in plain JavaScript. I also wrote two tutorials explaining how it worked.","You can try it again below. The navigation works, but the old contact form doesn’t send messages."],"image":"/static/lab/clas.png","dateNote":"The original Git history begins on 5 November 2012.","links":[["Explore Clas","https://nmn.gl/clas/"],["Source","https://github.com/namanyayg/clas"],["Archived site · 14 September 2013","https://web.archive.org/web/20130914023459/http://demos.namanyayg.com/clas/"]]},{"slug":"sympl","title":"Sympl.css","year":2012,"dateLabel":"November 2012","category":"design","summary":"My CSS starting point for new websites, before I made Webstiles.","paragraphs":["I kept needing a responsive grid and sensible type defaults when I started a new site, so I put them into one stylesheet. That became Sympl, which I later used for Webstiles.","The stylesheet is original. The demo page was rebuilt in 2026 to show how the grid and type work."],"image":"/static/lab/sympl.png","dateNote":"The original Git history begins on 6 November 2012.","links":[["Try the grid","https://nmn.gl/sympl/"],["Source","https://github.com/namanyayg/sympl"],["Archived site · 9 November 2012","https://web.archive.org/web/20121109054602/http://sympl.namanyayg.com/"]]},{"slug":"webstiles","title":"Webstiles","year":2013,"dateLabel":"January 2013","category":"design","summary":"How I showed clients a design before building their whole website.","paragraphs":["I made Webstiles when I started working with clients. I needed a way to show them colors, type and interface elements before spending time on the full website.","I’d make a Webstile, send it over, and work through their feedback. It became part of my usual workflow. The responsive template runs on Sympl."],"image":"/static/lab/webstiles.png","dateNote":"January 2013 is the date recorded in the existing portfolio.","links":[["Open Webstiles","https://nmn.gl/webstiles/"],["Source","https://github.com/namanyayg/webstiles"],["Archived site · 7 January 2013","https://web.archive.org/web/20130107223029/http://webstiles.namanyayg.com/"]]},{"slug":"win95anim","title":"Windows 95, in CSS","year":2013,"dateLabel":"June 2013","category":"experiments","summary":"My attempt to recreate the Windows 95 launch animation in CSS.","paragraphs":["I recreated the Windows 95 launch animation with four colored squares and CSS. It’s a small experiment in what you can do with keyframes and transforms.","The restored demo has a pause button and respects reduced-motion preferences."],"image":"/static/lab/win95anim.png","dateNote":"The original Git history begins on 4 June 2013.","links":[["Play the animation","https://nmn.gl/win95anim/"],["Source","https://github.com/namanyayg/win95anim"],["Archived site · 12 June 2013","https://web.archive.org/web/20130612053206/http://namanyayg.com/lab/win95anim/"]]},{"slug":"musicose","title":"MusiCose","year":2013,"dateLabel":"c. 2013","category":"experiments","summary":"I made a sideways-scrolling website for a fictional band from Mars.","paragraphs":["MusiCose was my website for a fictional Martian band, with colorful panels that move sideways across the screen. You can use the keyboard to move between them.","The original site works again as a static demo. Its fictional contact controls are disabled."],"image":"/static/lab/musicose.png","dateNote":"Wayback preserves the site on 16 April 2013. Surviving source files carry October 2013 timestamps; the original launch date is not established.","links":[["Open the demo","https://nmn.gl/old-experiments/musicose/"],["Source","https://github.com/namanyayg/old-experiments/tree/main/musicose"],["Archived site · 16 April 2013","https://web.archive.org/web/20130416153252/http://demos.namanyayg.com/musicose/"]]},{"slug":"min-slide","title":"MinSlide","year":2013,"dateLabel":"c. 2013","category":"experiments","summary":"An early image slider I wrote in JavaScript.","paragraphs":["I made MinSlide to move between images, with slide controls and autoplay. The controls work again, but the original hosted photos are gone. The restored demo uses labeled solid-color slides in their place."],"image":"/static/lab/min-slide.png","dateNote":"Surviving source files carry October 2013 timestamps; the original launch date is not established.","links":[["Open the demo","https://nmn.gl/old-experiments/min-slide/"],["Source","https://github.com/namanyayg/old-experiments/tree/main/min-slide"]]},{"slug":"keyzen","title":"KeyZen","year":2013,"dateLabel":"October 2013","category":"games","summary":"I wanted to type faster, so I made a game to practise.","paragraphs":["I was obsessed with improving my typing speed. My reasoning was simple: faster typing meant faster programming. So I made KeyZen in a few hours at a hackathon.","I especially enjoyed making the pastel keyboard and animating the keys. The game won first prize that day."],"image":"/static/lab/keyzen.png","dateNote":"October 2013 is the date recorded in the existing portfolio.","links":[["Play KeyZen","https://nmn.gl/KeyZen/"],["Archived site · 4 January 2016","https://web.archive.org/web/20160104185051/http://projects.namanyayg.com/KeyZen/"]]},{"slug":"portfolio-2013","title":"The freelance years begin","year":2013,"dateLabel":"2013–2014","category":"design","summary":"My teenage freelance portfolio, while I was working at MakeUseOf.","paragraphs":["I was working as a freelance designer and front-end developer, and had started working with MakeUseOf. My portfolio included their main site, MakeUseOf TV, a music website and Webstiles.","I’d already written out how I worked with clients, from the first questions through drafts and feedback to the finished site. Webstiles was both a project in the portfolio and something I used in that process.","The HTML remains, but the stylesheet and project thumbnails are missing. You can read the original introduction below; the old design hasn’t been reconstructed."],"image":"/static/lab/portfolio-2013.png","dateNote":"The page’s supporting files are dated October 2013; its surviving HTML was last modified on 9 January 2014.","excerpt":"Hello, I’m Namanyay Goel, a freelance designer & front end developer. I also work at MakeUseOf as their UI designer/front end developer.","textOnly":true,"links":[["Archived site · 18 June 2013","https://web.archive.org/web/20130618011659/http://namanyayg.com/"]]},{"slug":"tldrtech","title":"TLDR;Tech","year":2014,"dateLabel":"May–June 2014","category":"design","summary":"A tech news blog I started with two friends, with short summaries and a theme I designed.","paragraphs":["Two friends and I started TLDR;Tech to publish short tech news summaries. I spent a lot of time on the design and building the theme, but we only kept it going for a few weeks.","The screenshot is from June 2014. Wayback also has the homepage, with our news posts and the original design."],"image":"/static/archive/tldrtech.webp","dateNote":"I linked to tldrte.ch in a blog post on 28 May 2014. The earliest Wayback homepage capture is dated 2 June 2014; the screenshot shows news from 5 June. These are surviving records, not a confirmed launch date.","links":[["Archived site · 2 June 2014","https://web.archive.org/web/20140602031309/http://tldrte.ch/"],["My notes on building the theme","https://nmn.gl/blog/images-and-excerpts-a-few-practical-problems-with-ghost"]]},{"slug":"agrobot-cropstor","title":"Agrobot & Cropstor","year":2014,"dateLabel":"c. August 2014","category":"design","summary":"My competition work on irrigation and crop storage.","paragraphs":["I worked on two agricultural product concepts for JAD. Agrobot used moisture readings to show how a sensor-based irrigation system could work. Cropstor was a warehouse interface for recording farmers and their produce.","These are the original product pages, phone mockups and animation from that project."],"image":"/static/archive/agrobot.webp","dateNote":"The surviving product pages and assets are timestamped 1 August 2014. This dates the recovered edition, not a verified public launch.","gallery":[["cropstor.webp","The original Cropstor product page."],["agrobot-screen.webp","Agrobot’s mobile interface."],["cropstor-screen.webp","A warehouse interface screen."]],"video":"agrobot-rotation.mp4","videoCaption":"Original project motion study, preserved from the 2014 files."},{"slug":"code-warriors","title":"Code Warriors","year":2014,"dateLabel":"2014","category":"design","summary":"The site I made for my school’s technology club.","paragraphs":["“Hello world. We’re the Code Warriors.” I made this site for the technology club at DPS Vasant Kunj, with pages about our projects and competitions.","This is the homepage announcing Code Wars 2014."],"image":"/static/archive/code-warriors.webp","dateNote":"The page itself names Code Wars 2014; the recovered files are dated November 2014.","links":[["Earlier homepage · 17 May 2014","https://web.archive.org/web/20140517183302/http://code-warriors.org/"]]},{"slug":"code-in","title":"Google Code-in & FOSSASIA","year":2014,"dateLabel":"December 2014–January 2015","category":"learning","summary":"My tools and tutorials from Google Code-in with FOSSASIA.","paragraphs":["I worked on small utilities during Code-in, including an angle converter and a JSON validator. I also made an LXDE wallpaper and wrote tutorials about Jekyll, automated testing and p5.js.","You can read four of those tutorials below, including one about moving a MediaWiki installation."],"image":"/static/archive/code-in.webp","dateNote":"The surviving repository runs from 8 December 2014 to 17 January 2015.","gallery":[["codein-wallpaper.webp","An original LXDE wallpaper from the Code-in collection."]],"reading":true},{"slug":"physics","title":"Physics, made visible","year":2015,"dateLabel":"February 2015","category":"learning","summary":"I turned my physics coursework into browser simulations.","paragraphs":["I wanted to play with the physics I was learning in class, so I made simulations for things like oscillation and collisions. You can change the inputs and watch what happens in the Physics collection."],"image":"/static/lab/physics.png","dateNote":"February 2015 is the date recorded in the existing portfolio.","links":[["Explore the simulations","https://nmn.gl/physics/"],["Archived site · 13 December 2015","https://web.archive.org/web/20151213040721/http://projects.namanyayg.com/gyan/"]]},{"slug":"karya","title":"Karya","year":2015,"dateLabel":"May 2015","category":"apps","summary":"My to-do app for choosing three priorities each day.","paragraphs":["I built Karya around a short list: three priorities in the morning, then a check-in at night. Choosing what goes on the list is part of using it.","You can try that idea below. This version saves your list in your browser and doesn’t use the original app’s accounts or server."],"image":"/static/archive/karya.webp","dateNote":"The first surviving commit is dated 11 May 2015; the last is from November 2015.","interactive":"karya","links":[["Archived site · 13 December 2015","https://web.archive.org/web/20151213040659/http://karya.namanyayg.com/"]]},{"slug":"libo","title":"Libo","year":2015,"dateLabel":"August 2015","category":"apps","summary":"My mobile app concept for household budgeting.","paragraphs":["I designed Libo to show household expenses and spending history, with a flow for adding a new expense.","These are the original landing page and mobile screens from the competition project."],"image":"/static/archive/libo.webp","dateNote":"The repository records work on 27–28 August 2015.","gallery":[["libo-splash.webp","An original Libo mobile screen."]]},{"slug":"digital-india","title":"Digital India","year":2015,"dateLabel":"c. October 2015","category":"design","summary":"An app mockup I made for C.O.R.E.","paragraphs":["I made this Digital India mockup for C.O.R.E. It puts news and program information into a mobile interface. The screenshot shows the original screens."],"image":"/static/archive/digital-india.webp","dateNote":"The HTML, stylesheet and images carry 27 October 2015 timestamps."},{"slug":"bandc","title":"Bulls & Cows","year":2015,"dateLabel":"November 2015","category":"games","summary":"We studied Bulls & Cows and wrote a paper in 48 hours.","paragraphs":["Aditya and I spent the C.O.R.E. hackathon studying Bulls & Cows and the algorithms used to solve it. We wrote a research paper and a JavaScript demo in 48 hours.","It was our first time using LaTeX, and the project won first prize."],"image":"/static/lab/bandc.png","dateNote":"November 2015 is the date recorded in the existing portfolio.","links":[["Try the solver","https://nmn.gl/moo/"],["Read the paper","https://vixra.org/pdf/1601.0302v1.pdf"],["Archived site · 30 March 2018","https://web.archive.org/web/20180330133815/http://projects.namanyayg.com/moo/"]]},{"slug":"unexpend","title":"Unexpend","year":2016,"dateLabel":"June–August 2016","category":"apps","summary":"My search engine for comparing prices across stores.","paragraphs":["I built Unexpend to compare products across stores. It had parsers for Amazon and Flipkart, and a cache for search results.","This is the original cover artwork. The shopping APIs and prices are no longer connected."],"image":"/static/archive/unexpend.webp","dateNote":"The surviving Git history begins on 23 June 2016 and continues into August 2016.","links":[["Archived site · 11 August 2016","https://web.archive.org/web/20160811135946/http://unexpend.com/"]]},{"slug":"playtogether","title":"PlayTogether","year":2016,"dateLabel":"October 2016","category":"apps","summary":"I made a shared YouTube player so people could watch together.","paragraphs":["I used Socket.IO to share playback actions between YouTube players. You could paste a link, start a room and watch together, with everyone’s player kept in sync.","This is the original prototype. The room server is no longer connected."],"image":"/static/archive/playtogether.webp","dateNote":"The surviving repository contains four commits from 1 October 2016."},{"slug":"dubmaps","title":"DubMaps","year":2016,"dateLabel":"October 2016","category":"apps","summary":"My campus map for classes and events at the University of Washington.","paragraphs":["I put classes and scheduled events on a map of the UW campus, attached to the buildings where they happened.","The map here was redrawn from the original building coordinates. It doesn’t include personal records or old class schedules."],"image":"/static/archive/dubmaps.svg","dateNote":"The repository begins on 15 October 2016 and continues through 17 October 2016.","links":[["Archived site · 22 October 2016","https://web.archive.org/web/20161022171215/http://dubmaps.com/"]]},{"slug":"lccpp","title":"Less Confusing C++","year":2017,"dateLabel":"June 2017","category":"learning","summary":"I rewrote my school’s C++ coursework as a free book.","paragraphs":["I was frustrated with the study material for my introductory C++ course. I thought the structure could be much clearer, so I wrote the book I wanted to learn from.","I made it free because I was writing for other students. You can read Less Confusing C++ on Leanpub."],"image":"/static/lab/lccpp.png","dateNote":"June 2017 is the publication date recorded in the existing portfolio, rather than a verified manuscript start date.","links":[["Read the book","https://leanpub.com/lessconfusingcpp"],["Archived site · 26 August 2019","https://web.archive.org/web/20190826044032/https://leanpub.com/lessconfusingcpp"]]},{"slug":"portfolio-2018","title":"A portfolio in motion","year":2018,"dateLabel":"May–July 2018","category":"design","summary":"My 2018 portfolio, with client mockups and animated transitions.","paragraphs":["I was working as a web and blockchain consultant when I made this edition of my portfolio. I used project mockups and animated transitions to show the client work.","These screenshots come from the original build. By November 2023, I’d kept the same layout and changed the introduction to web and mobile consulting."],"image":"/static/archive/portfolio-2018.webp","dateNote":"The portfolio repository starts on 9 May 2018; its animation and responsive-layout commits continue into July. The later snapshot is dated November 2023.","gallery":[["portfolio-2018-work.webp","Client-work layout from the 2018 build."],["portfolio-2023.webp","The later web and mobile consulting edition, preserved in a November 2023 snapshot."]],"links":[["Archived site · 16 August 2018","https://web.archive.org/web/20180816163628/http://nmn.gl/"]]},{"slug":"indiasmile","title":"IndiaSmile","year":2020,"dateLabel":"June 2020","category":"apps","summary":"We made a COVID tracker and community during lockdown.","paragraphs":["When COVID hit, I wanted a way for my friends and family to stay informed, and somewhere to unwind. My team and I made IndiaSmile, combining pandemic statistics with resources and a WhatsApp and Telegram community.","The community grew to more than 2,500 members. As traffic increased, I had to adapt the backend to keep up."],"image":"/static/lab/indiasmile.png","dateNote":"June 2020 is the date recorded in the existing portfolio.","links":[["Visit IndiaSmile","https://indiasmile.github.io/"],["Archived site · 8 March 2021","https://web.archive.org/web/20210308150157/https://indiasmile.org///"]]},{"slug":"nataco","title":"Nataco","year":2021,"dateLabel":"2020–2021","category":"design","summary":"My studio’s website, with custom illustrations and a 3D animation.","paragraphs":["At Nataco, we worked on web applications, Shopify sites and design subscriptions. Our website combined custom illustrations with expressive type and a 3D scene.","You can see the original animation and illustrations below. Wayback also preserves an earlier Nataco homepage from August 2020, with a different design."],"image":"/static/archive/nataco.webp","dateNote":"The recovered site repository starts on 23 February 2020 and includes a Dyeus → Nataco rename on 24 June 2021. A separate Nataco homepage was already archived on 13 August 2020; the repository rename does not date the brand’s beginning.","gallery":[["nataco-services.webp","The original services page."],["nataco-illustration-1.svg","An original illustration from the site’s visual system."],["nataco-illustration-2.svg","Another illustration from the same collection."]],"video":"nataco-hero.webm","videoCaption":"The original Nataco hero animation. Use the player controls to watch or pause.","links":[["Earlier homepage · 13 August 2020","https://web.archive.org/web/20200813062639/https://nataco.us/"]]},{"slug":"kevin","title":"Kevin","year":2024,"dateLabel":"March 2024","category":"apps","summary":"My open-source interface for an AI software engineer.","paragraphs":["I’d wanted to make a bot that could write code for me for a long time. Kevin was my open-source interface for an AI software engineer, inspired by Devin and named for Kevin Mitnick."],"image":"/static/lab/kevin.png","dateNote":"March 2024 is the date recorded in the existing portfolio.","links":[["Explore the source","https://github.com/namanyayg/kevin-coder-ai"]]},{"slug":"aiindians","title":"AI Indians","year":2024,"dateLabel":"June 2024","category":"apps","summary":"My directory and leaderboard for India’s AI builders.","paragraphs":["I made AI Indians to bring Indian AI startups into one directory, with a leaderboard tracking their growth."],"image":"/static/lab/aiindians.png","dateNote":"June 2024 is the date recorded in the existing portfolio.","links":[["Explore the source","https://github.com/namanyayg/aiindians"],["Archived site · 11 June 2024","https://web.archive.org/web/20240611143154/http://aiindians.org/"]]},{"slug":"air","title":"Air","year":2024,"dateLabel":"November 2024","category":"apps","summary":"I used illustrations to explain what an air-quality reading means.","paragraphs":["I made Air to explain AQI readings with a calculator and illustrations people could share."],"image":"/static/lab/air.png","dateNote":"November 2024 is the date recorded in the existing portfolio.","links":[["Explore Air","https://air.nmn.gl/"],["Archived site · 15 November 2024","https://web.archive.org/web/20241115112513/https://air.nmn.gl/"]]},{"slug":"giga","title":"Giga","year":2025,"dateLabel":"January 2025","category":"apps","summary":"My AI coding assistant, built around understanding a whole codebase.","paragraphs":["I built Giga to keep codebase context available while helping with testing, debugging and integrations."],"image":"/static/lab/giga.png","dateNote":"January 2025 is the date recorded in the existing portfolio.","links":[["Read the introduction","https://nmn.gl/blog/giga-intro"],["Archived site · 11 March 2025","https://web.archive.org/web/20250311091535/http://gigamind.dev/"]]},{"slug":"trends-ai","title":"Trend Analyzer","year":2025,"dateLabel":"January 2025","category":"apps","summary":"My tool for finding recurring topics in online discussions.","paragraphs":["I made Trend Analyzer to gather online discussions and find recurring topics, so there was less scrolling to do when researching something."],"image":"/static/lab/trends-ai.png","dateNote":"January 2025 is the date recorded in the existing portfolio.","links":[["Open Trend Analyzer","https://trends.nmn.gl/"],["Archived site · 19 June 2025","https://web.archive.org/web/20250619095730/https://trends.nmn.gl/"]]}]


